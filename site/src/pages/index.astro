---
// Copy: condensed from Lina’s own drafts and prayer letter; needs her final
// approval before deployment (site.copyReviewedByLina). Sources and open
// questions for every line: docs/COPY-LEDGER.md.
//
// One poster, six states. Each chapter is a :target scene, so the URL hash
// alone decides what shows: links, Back and deep links work without
// JavaScript, and rapid switching can never leave a stale state.
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site.ts';
import hero from '../assets/hero/hero-sky.jpg';
import gathering from '../assets/gallery/gathering.jpg';
import allSouls from '../assets/gallery/all-souls.jpg';
import freeEnglish from '../assets/gallery/free-english.jpg';
import cafe from '../assets/gallery/cafe.jpg';

// The wide photo is cropped by object-fit: cover (and scaled up to 1.22 in
// some states), so on a tall phone screen it renders at ~4× the viewport width.
const heroSizes = '(orientation: portrait) 400vw, max(120vw, 210vh)';
// Chapter photographs fill large panels; widths stop at each source's own size.
// Eager but low priority: they arrive after the hero, before anyone opens a chapter,
// so a panel never wipes in empty.
const plate = { formats: ['avif', 'webp'] as Array<'avif' | 'webp'>, widths: [480, 800, 1200, 1440], loading: 'eager' as const, fetchpriority: 'low' as const, decoding: 'async' as const };

const nav = [
  { id: 'story', title: 'Story' },
  { id: 'year', title: 'The year' },
  { id: 'month', title: 'First month' },
  { id: 'support', title: 'Support' },
  { id: 'prayer', title: 'Prayer' },
];
---

<BaseLayout
  title="Lina Makarenko — linway"
  description="Lina Makarenko was accepted for the 2026–⁠27 Ministry Training Scheme at All Souls, London. Read her story, pray with her, or give through Stewardship."
>
  <div class="gate" id="gate">
    <a class="gate-enter" href="#home" aria-label="Enter linway">
      <span class="gate-word" aria-hidden="true">LINWA<span class="gate-y">Y<span class="gate-stem"></span></span></span>
      <span class="gate-foot">
        <span class="mono">Lina Makarenko</span>
        <span class="gate-cue mono">Enter<Icon name="arrow-right" /></span>
      </span>
    </a>
    <a class="gate-skip mono" href="#home">Skip intro</a>
    <span class="gate-line" aria-hidden="true"></span>
  </div>

  <div class="poster">
    <Picture
      src={hero}
      formats={['avif', 'webp']}
      widths={[800, 1200, 1600, 2400]}
      sizes={heroSizes}
      alt="A raised hand holding a Bible against a blue sky."
      loading="eager"
      fetchpriority="high"
      class="poster-image"
    />
    <div class="scrim" aria-hidden="true"></div>

    <header class="masthead">
      <a class="wordmark" href="#home" translate="no" aria-label="linway, home">linway</a>
      <nav aria-label="Chapters">
        <ul>
          {nav.map((n) => <li><a href={`#${n.id}`}>{n.title}</a></li>)}
        </ul>
      </nav>
    </header>

    <main class="stage">
      <section class="scene scene-home" id="home" aria-labelledby="title">
        <div class="text">
          <div class="home-kicker">
            <p class="name mono">Lina Makarenko</p>
            <a class="next mono" href="#story">Next: Story<Icon name="arrow-right" /></a>
          </div>
          <h1 id="title"><span>What</span> <span>next?</span></h1>
          <p class="lede">I prayed about that question for a long time. Then I was accepted for the 2026–⁠27 Ministry Training Scheme at All Souls, London.</p>
        </div>
      </section>

      <section class="scene scene-story" id="story" aria-labelledby="story-title">
        <div class="text">
          <div class="kicker">
            <h2 id="story-title" class="mono">Story</h2>
            <a class="next mono" href="#year">Next: The year<Icon name="arrow-right" /></a>
          </div>
          <p class="display">Faith became my own.</p>
          <ol class="route">
            <li><span class="stop">Omsk</span><p>I grew up in a Christian family. My parents were missionaries from Latvia.</p></li>
            <li><span class="stop">At 17</span><p>I was baptised and I served in church on the worship team, youth group and church camps.</p></li>
            <li><span class="stop">Riga, 2023</span><p>I moved to Latvia to study Business and Management, and worked alongside my studies.</p></li>
            <li><span class="stop">What next?</span><p>A Master’s, or staying in my job. Both were good. I had peace about neither.</p></li>
          </ol>
        </div>
        <figure class="plate plate-gathering">
          <Picture src={gathering} {...plate} sizes="(orientation: portrait) 100vw, 58vw" alt="Lina, seen from behind in a room of green chairs, her hair up and her arm around the shoulders of the smaller person beside her, who wears a hood." />
        </figure>
      </section>

      <section class="scene scene-year" id="year" aria-labelledby="year-title">
        <div class="text">
          <div class="kicker">
            <h2 id="year-title" class="mono">The year</h2>
            <a class="next mono" href="#month">Next: First month<Icon name="arrow-right" /></a>
          </div>
          <p class="display">2026–⁠27</p>
          <p class="verbs"><span>Learn</span> <span>Serve</span> <span>Grow</span> <span>Discern</span></p>
          <div class="lines">
            <p>The Ministry Training Scheme at All Souls Church, London brings practical ministry, theological training and discipleship together in one local church.</p>
            <p>At Free English, people from different countries come to learn English and spend time together. I’m learning how to serve there alongside the team.</p>
            <p>I want to build real friendships there, learn from experienced leaders, and take time to see where God leads next.</p>
          </div>
          {/* One photograph at a time; native radios work with arrow keys and without script. */}
          <fieldset class="switch">
            <legend class="visually-hidden">Photo</legend>
            <label><input type="radio" name="year-photo" value="church" checked /><span>All Souls</span></label>
            <label><input type="radio" name="year-photo" value="english" /><span>Free English</span></label>
          </fieldset>
        </div>
        <div class="plates plates-year">
          <figure class="plate plate-church">
            <Picture src={allSouls} {...plate} sizes="(orientation: portrait) 100vw, 54vw" alt="A round, columned church porch and tall needle spire lit up at night, a blue-lit building behind, cyclists and a bus in the street below." />
          </figure>
          <figure class="plate plate-english">
            <Picture src={freeEnglish} {...plate} sizes="(orientation: portrait) 100vw, 54vw" alt="Lina and another young woman smiling, both wearing ‘Hello!’ name badges, in a hall of people at tables; the screen behind reads ‘Free English Classes’." />
          </figure>
        </div>
      </section>

      <section class="scene scene-month" id="month" aria-labelledby="month-title">
        <div class="text">
          <div class="kicker">
            <h2 id="month-title" class="mono">First month</h2>
            <a class="next mono" href="#support">Next: Support<Icon name="arrow-right" /></a>
          </div>
          <p class="display">One month in.</p>
          <div class="lines">
            <p>A new city, church and team. I’m still finding my rhythm, and speaking English every day has been the hardest part.</p>
            <p>At Free English, people come to learn English and spend time together. I’m getting to know the team and the people who come.</p>
            <p>We’re studying 1 Corinthians and talking about discipleship. I’m seeing how much can happen through ordinary friendships and conversations.</p>
          </div>
          {/* Native disclosure: keyboard and no-JS friendly, opens in place. */}
          <details class="more">
            <summary>More from the month</summary>
            <p>In the first month, Free English held four days of sessions. The morning group is for women; evening sessions are open to everyone. At a formation conference in Nottingham, I was reminded to care for my own relationship with God as I learn to serve others.</p>
          </details>
        </div>
        <figure class="plate plate-cafe">
          <Picture src={cafe} {...plate} sizes="(orientation: portrait) 100vw, 64vw" alt="Lina and two friends sit together in a café, holding green iced drinks." />
        </figure>
      </section>

      <section class="scene scene-support" id="support" aria-labelledby="support-title">
        <div class="text">
          <div class="kicker">
            <h2 id="support-title" class="mono">Support</h2>
            <a class="next mono" href="#prayer">Next: Prayer<Icon name="arrow-right" /></a>
          </div>
          <p class="display"><span>Voluntary.</span> <span>Unpaid.</span></p>
          <div class="lines">
            <p>The Ministry Training Scheme is a voluntary training year. Trainees aren’t paid a salary.</p>
            <p>Gifts help with the practical side of the year, like accommodation, travel and day-to-day living.</p>
            <p>Prayer matters most to me. If you’d also like to give, my Stewardship page is the way to do it.</p>
          </div>
        </div>
      </section>

      <section class="scene scene-prayer" id="prayer" aria-labelledby="prayer-title">
        <div class="text">
          <div class="kicker">
            <h2 id="prayer-title" class="mono">Prayer</h2>
            <a class="next mono" href="#home"><Icon name="arrow-left" />Back to the start</a>
          </div>
          <p class="intro">If you pray, please remember:</p>
          <ol class="requests">
            <li><span class="mono" aria-hidden="true">01</span>For my relationship with God to stay at the centre of this year.</li>
            <li><span class="mono" aria-hidden="true">02</span>For confidence to understand and speak English.</li>
            <li><span class="mono" aria-hidden="true">03</span>For people at Free English to come to know Jesus and for our team to serve well together.</li>
          </ol>
        </div>
      </section>

      <div class="actions">
        <a class="donate" href={site.donate.href}><span class="donate-text"><span class="donate-label">{site.donate.label}</span><span class="visually-hidden">. </span><span class="donate-via">{site.donate.via}</span></span><Icon name="arrow-up-right" /></a>
        <a class="social" href={site.instagram.href} rel="me"><Icon name="instagram" /><span>Instagram</span></a>
      </div>
      <section class="contact" aria-labelledby="contact-title">
        <h2 id="contact-title" class="mono">Contact Lina</h2>
        <ul>
          <li><a href={site.contact.whatsapp.href}><span class="contact-kind">WhatsApp</span> {site.contact.whatsapp.label}</a></li>
          <li><a href={site.contact.email.href}><span class="contact-kind">Email</span> {site.contact.email.label}</a></li>
        </ul>
      </section>
    </main>
  </div>
</BaseLayout>

<script>
  // Enhancement only: chapters switch through :target in CSS.
  const root = document.documentElement;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.masthead nav a')];
  const current = () => links.find((a) => a.hash === location.hash);
  const sync = () => {
    for (const a of links) a.removeAttribute('aria-current');
    current()?.setAttribute('aria-current', 'location');
  };
  addEventListener('hashchange', sync);
  sync();

  // Entry: shown only when the head script set .entry (JS on, first visit this
  // session, no deep link, motion allowed). Its links point to #home, so even
  // if this script fails, following them hides the gate through CSS.
  const gate = document.getElementById('gate')!;
  const poster = document.querySelector<HTMLElement>('.poster')!;
  const entering = () => root.classList.contains('entry');
  let running = false;

  function finish() {
    if (!entering()) return;
    for (const a of gate.getAnimations({ subtree: true })) a.cancel();
    root.classList.replace('entry', 'entered');
    poster.inert = false;
    try { sessionStorage.setItem('linway-entered', '1'); } catch {}
    if (gate.contains(document.activeElement)) document.querySelector<HTMLElement>('.wordmark')!.focus({ preventScroll: true });
  }

  // The Y's stem becomes the line: it grows to full height, then travels left
  // across the screen as the edge of the reveal.
  function enter() {
    if (running) return finish();
    running = true;
    const stem = gate.querySelector('.gate-stem')!.getBoundingClientRect();
    const line = gate.querySelector<HTMLElement>('.gate-line')!;
    const w = innerWidth;
    const h = innerHeight;
    // While it travels the stem thins to a hairline; its right edge is the reveal edge.
    const thin = 3;
    line.style.left = `${stem.left}px`;
    line.style.width = `${stem.width}px`;
    const ease = 'cubic-bezier(0.77, 0, 0.175, 1)';
    const grow = 240;
    const travel = 560;
    const timing = { duration: grow + travel, fill: 'forwards' } as const;
    const at = grow / (grow + travel);
    gate.querySelector('.gate-y')!.animate({ color: ['var(--color-oxblood)', 'transparent'] }, { duration: 140, fill: 'forwards' });
    line.animate([
      { offset: 0, easing: ease, clipPath: `inset(${stem.top}px 0 ${h - stem.bottom}px 0)`, transform: 'none' },
      { offset: at, easing: ease, clipPath: 'inset(0 0 0 0)', transform: 'none' },
      { offset: 1, clipPath: 'inset(0 0 0 0)', transform: `translateX(${-stem.left}px) scaleX(${thin / stem.width})` },
    ], timing);
    gate.animate([
      { offset: 0, easing: ease, clipPath: 'inset(0 0 0 0)' },
      { offset: at, easing: ease, clipPath: `inset(0 ${w - stem.right}px 0 0)` },
      { offset: 1, clipPath: `inset(0 ${w - thin}px 0 0)` },
    ], timing).finished.then(finish, () => {});
  }

  if (entering()) {
    poster.inert = true;
    gate.querySelector('.gate-enter')!.addEventListener('click', (e) => { e.preventDefault(); enter(); });
    gate.querySelector('.gate-skip')!.addEventListener('click', (e) => { e.preventDefault(); finish(); });
    addEventListener('hashchange', finish);
  }

  document.addEventListener('keydown', (e) => {
    if (entering()) {
      if (e.key === 'Escape') finish();
      else if (e.key === 'Enter' && !gate.contains(document.activeElement)) { e.preventDefault(); enter(); }
      return;
    }
    const link = e.key === 'Escape' && current();
    if (!link) return;
    location.hash = 'home';
    link.focus({ preventScroll: true });
  });
</script>

<style>
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* Registered so the scrim and accent can transition between states. */
  @property --s0 { syntax: '<color>'; inherits: true; initial-value: transparent; }
  @property --s1 { syntax: '<color>'; inherits: true; initial-value: transparent; }
  @property --reach { syntax: '<percentage>'; inherits: true; initial-value: 58%; }
  @property --band { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @property --accent { syntax: '<color>'; inherits: true; initial-value: #8b2e3d; }

  /* ---------- Entry: LINWAY, whose Y becomes the line that opens the page ---------- */
  .gate { display: none; }
  :global(.entry) .gate {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 20;
    background: var(--color-sky-light);
    color: var(--color-ink);
  }
  /* If the script never runs, the #home link still gets the visitor in. */
  :global(.entry):has(.scene:target) .gate { display: none; }
  .gate-enter {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: clamp(1rem, 3vh, 2rem);
    padding: 0 var(--gutter);
    text-decoration: none;
    cursor: pointer;
  }
  .gate-enter:focus-visible { outline-offset: -0.75rem; }
  .gate-word {
    display: block;
    font-size: calc((100vw - 2 * var(--gutter)) / 3.02);
    font-weight: 800;
    font-stretch: 68%;
    line-height: 0.74;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .gate-y { position: relative; color: var(--color-oxblood); }
  /* Sits exactly on the Y's stem; the script reads its box. */
  .gate-stem { position: absolute; left: 50%; bottom: 0.21em; width: 0.155em; height: 0.27em; translate: -50% 0; }
  .gate-foot { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .gate-cue { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; color: var(--color-oxblood); }
  .gate-cue :global(.icon) { transition: transform 180ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .gate-enter:hover .gate-cue :global(.icon) { transform: translateX(0.25rem); }
  }
  .gate-skip {
    position: absolute;
    top: max(1rem, env(safe-area-inset-top));
    right: var(--gutter);
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    text-decoration: underline;
  }
  .gate-line {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--color-oxblood);
    clip-path: inset(50% 0);
    transform-origin: left;
    pointer-events: none;
  }
  /* While the gate is up, the page's own arrival waits behind it. */
  :global(.entry):not(:has(.scene:target)) .poster :global(*) { animation-play-state: paused !important; }
  :global(:is(.entry, .entered)) .poster > :global(picture) { animation: none; }

  /* ---------- The poster and its states ---------- */
  .poster {
    --safe-top: max(clamp(0.6rem, 1.8vw, 1.5rem), env(safe-area-inset-top));
    --safe-left: max(var(--gutter), env(safe-area-inset-left));
    --safe-right: max(var(--gutter), env(safe-area-inset-right));
    /* Home: pale mist on the copy side, ink type. */
    --s0: rgb(237 243 247 / 0.9);
    --s1: rgb(237 243 247 / 0.62);
    --reach: 58%;
    --band: 50%;
    --accent: var(--color-oxblood);
    --solid: var(--color-paper); /* the scrim when transparency is reduced */
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    min-height: 100svh;
    overflow: clip; /* the scaled photo never adds scrollbars */
    background: #a9c3da; /* the sky colour shows first, before the photo reveal */
    color: var(--color-ink);
    transition: --s0 500ms ease, --s1 500ms ease, --reach 600ms var(--ease-in-out), --band 600ms var(--ease-in-out), --accent 300ms ease, color 300ms ease;
  }
  /* Each photo chapter takes its colours from its own photograph. */
  /* Story: warm paper and the gathering's dark chair green; the brand oxblood marks the turn. */
  .poster:has(#story:target) {
    --s0: #f3eadb; --s1: #f3eadb; --reach: 300%; --band: 100%;
    --accent: #8b2e3d; --line: #1f3a2c; --btn: #1f3a2c; --btn-ink: #f3eadb; --solid: #f3eadb;
    color: #18291f;
  }
  /* The year: All Souls' night and the light of its street lamp. */
  .poster:has(#year:target) {
    --s0: #0e1233; --s1: #0e1233; --reach: 300%; --band: 100%;
    --accent: #f2c27b; --lamp: #f2c27b; --btn: #f2c27b; --btn-ink: #0e1233; --solid: #0e1233;
    color: #e8ebfb;
  }
  /* First month: the café's warm oat light and matcha; espresso ink, the shared oxblood. */
  .poster:has(#month:target) {
    --s0: #e7e0c9; --s1: #e7e0c9; --reach: 300%; --band: 100%;
    --accent: #8b2e3d; --btn: #2c2219; --btn-ink: #f3eadb; --solid: #e7e0c9;
    color: #2c2219;
  }
  /* Support: oxblood over the copy side; the Bible shows again on the right. */
  .poster:has(#support:target) {
    --s0: rgb(111 34 48 / 0.97); --s1: rgb(111 34 48 / 0.95); --reach: 64%; --band: 78%;
    --accent: #f6d3d9; --solid: var(--color-oxblood-deep);
    --btn: var(--color-paper); --btn-ink: var(--color-oxblood-deep); --btn-hover: #fff;
    color: var(--color-paper);
  }
  /* Prayer: cooler and lighter, more sky. */
  .poster:has(#prayer:target) { --s0: rgb(237 243 247 / 0.96); --s1: rgb(237 243 247 / 0.8); --reach: 72%; --band: 70%; }

  /* <picture> (and its <source>s) must not take grid rows. */
  .poster > :global(picture) { position: absolute; inset: 0; z-index: -3; }
  .poster :global(.poster-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 64% 42%;
    /* Each state re-crops the one photograph. Translation stays inside the
       scale margin, so no edge ever shows. */
    transition: transform 650ms var(--ease-in-out);
  }
  .poster:has(#story:target) :global(.poster-image),
  .poster:has(#month:target) :global(.poster-image) { transform: scale(1.1) translate(4%, -2%); }
  .poster:has(#year:target) :global(.poster-image) { transform: scale(1.22) translate(4%, 5%); }
  .poster:has(#support:target) :global(.poster-image) { transform: scale(1.14) translate(5%, 2%); }
  .poster:has(#prayer:target) :global(.poster-image) { transform: scale(1.08) translate(3%, 3%); }

  .scrim {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: linear-gradient(90deg, var(--s0) 0%, var(--s1) calc(var(--reach) * 0.6), transparent var(--reach));
  }

  /* ---------- Header: wordmark and the chapters, top left ---------- */
  .masthead {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 clamp(1.5rem, 3.2vw, 3rem);
    padding: var(--safe-top) var(--safe-right) 0 var(--safe-left);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    translate: 0 -0.2rem;
    min-height: 2.75rem;
    font-size: 1.35rem;
    font-weight: 600;
    font-stretch: 85%;
    letter-spacing: -0.02em;
    line-height: 1;
    text-decoration: none;
  }
  .masthead ul { display: flex; flex-wrap: wrap; gap: 0 clamp(1.1rem, 2.2vw, 2.1rem); margin: 0; padding: 0; list-style: none; }
  .masthead nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.15rem;
    font-weight: 600;
    letter-spacing: 0.005em;
    text-decoration: none;
    /* The underline draws in for hover (thin) and the current chapter (thick). */
    background: linear-gradient(var(--accent), var(--accent)) left calc(50% + 0.85em) / 0 2px no-repeat;
    transition: background-size 260ms var(--ease-out), color 200ms ease;
  }
  .masthead nav a:active { color: var(--accent); }
  @media (hover: hover) and (pointer: fine) {
    .masthead nav a:hover { background-size: 100% 1px; }
  }
  .poster:has(#story:target) .masthead a[href="#story"],
  .poster:has(#year:target) .masthead a[href="#year"],
  .poster:has(#month:target) .masthead a[href="#month"],
  .poster:has(#support:target) .masthead a[href="#support"],
  .poster:has(#prayer:target) .masthead a[href="#prayer"] { color: var(--accent); background-size: 100% 2px; }

  /* ---------- Stage: the scenes share one cell; the actions sit under them ---------- */
  .stage {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: clamp(1.4rem, 3.5vh, 2.25rem);
    padding: clamp(1.25rem, 4vh, 3rem) var(--safe-right) max(clamp(1.75rem, 6vh, 4rem), env(safe-area-inset-bottom)) var(--safe-left);
  }
  .scene {
    grid-area: 1 / 1;
    /* Off-stage scenes collapse to no height (so they never stretch the page),
       fade out quickly, then hide from focus and assistive tech. They stay
       unpositioned, so photo panels always measure against the whole poster. */
    height: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 6rem);
    visibility: hidden;
    opacity: 0;
    transition: opacity 130ms ease, visibility 0s linear 130ms;
    /* A chapter link always lands at the top of the page, header in view. */
    scroll-margin-top: 100svh;
  }
  .text { max-width: 44rem; }
